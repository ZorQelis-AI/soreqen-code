# Your own API keys, for SoreQen Code without a SoreQen plan.
#
# Keep them in ~/.soreqen/.env (`soreqen keys set <provider>` writes it for you),
# not in a project: a .env in a repository is one commit away from being public.
# Set one provider; the model line is optional where a default exists.

# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_BASE_URL=            # any OpenAI-compatible endpoint

# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=

# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# OPENCODE_API_KEY=
# OPENCODE_MODEL=mimo-v2.6-flash

# Turn off the once-a-day check for a newer version.
# SOREQEN_NO_UPDATE_CHECK=1
