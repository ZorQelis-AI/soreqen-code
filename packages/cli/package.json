{
  "name": "@sqcode/cli",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "soreqen": "./bin/soreqen.js",
    "sqcode": "./bin/soreqen.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "start": "node ./bin/soreqen.js",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@sqcode/mcp": "workspace:*",
    "@sqcode/orchestrator": "workspace:*",
    "@sqcode/sandbox-runner": "workspace:*",
    "@sqcode/shared": "workspace:*",
    "@sqcode/tools": "workspace:*",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZorQelis-AI/soreqen-code",
    "directory": "packages/cli"
  }
}
