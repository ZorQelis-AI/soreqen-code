{
  "name": "@sqcode/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "SoreQen Code's Model Context Protocol client: connects MCP servers and offers their tools to the agent.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "@sqcode/orchestrator": "workspace:*",
    "@sqcode/sandbox-runner": "workspace:*",
    "@sqcode/tools": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZorQelis-AI/soreqen-code",
    "directory": "packages/mcp"
  }
}
